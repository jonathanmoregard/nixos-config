#!/usr/bin/env python3
"""Print the previous session's real turns for the current directory.

Skips this session's own transcript, strips the wrappers that make a
transcript unreadable (system reminders, IDE selection notices, task
notifications, local command output), and prints the tail that says what
the user was doing.

Usage: last-session [-n TURNS] [-d DIR] [--session ID]
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import sys

NOISE = re.compile(
    r"<(system-reminder|ide_opened_file|ide_selection|task-notification|"
    r"local-command-stdout|command-name|command-message)\b",
)
STRIP = re.compile(
    r"<(ide_opened_file|ide_selection)>.*?</\1>|<system-reminder>.*?</system-reminder>",
    re.DOTALL,
)


def text_of(entry: dict) -> str:
    message = entry.get("message") or {}
    content = message.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(
            part.get("text", "")
            for part in content
            if isinstance(part, dict) and part.get("type") == "text"
        )
    return ""


def role_of(entry: dict) -> str:
    return (entry.get("message") or {}).get("role") or entry.get("type") or ""


def turns(path: pathlib.Path) -> list[tuple[str, str, str]]:
    out: list[tuple[str, str, str]] = []
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            role = role_of(entry)
            if role not in {"user", "assistant"}:
                continue
            body = STRIP.sub("", text_of(entry)).strip()
            if not body or NOISE.search(body):
                continue
            if body.startswith("Shell cwd was reset"):
                continue
            out.append((role, entry.get("timestamp", "?"), body))
    return out


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("-n", "--turns", type=int, default=12)
    parser.add_argument("-d", "--dir", default=os.getcwd())
    parser.add_argument("--session", default=os.environ.get("CLAUDE_SESSION_ID", ""))
    args = parser.parse_args()

    # Editor and terminal sessions keep separate projects/ dirs, so a reset
    # editor session resuming terminal work (or the reverse) must see both.
    roots = [os.environ.get("CLAUDE_CONFIG_DIR"), os.path.expanduser("~/.claude")]
    slug = str(pathlib.Path(args.dir).resolve()).replace("/", "-")
    searched = []
    files: list[pathlib.Path] = []
    for root in dict.fromkeys(r for r in roots if r):
        project = pathlib.Path(root) / "projects" / slug
        searched.append(str(project))
        if project.is_dir():
            # An empty --session must exclude nothing; "" is a substring of
            # every stem, which would hide all transcripts.
            files += [
                p for p in project.glob("*.jsonl")
                if not (args.session and args.session in p.stem)
            ]

    if not files:
        print("no other session transcript for this directory; looked in:",
              file=sys.stderr)
        for path in searched:
            print(f"  {path}", file=sys.stderr)
        return 1
    files.sort(key=lambda p: p.stat().st_mtime, reverse=True)

    newest = files[0]
    collected = turns(newest)
    print(f"# {newest}")
    print(f"# {len(collected)} turns; showing last {min(args.turns, len(collected))}\n")
    for role, stamp, body in collected[-args.turns :]:
        print(f"## {role.upper()}  {stamp}")
        print(body)
        print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
