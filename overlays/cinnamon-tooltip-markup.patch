Validate tooltip markup before enabling it

A tooltip's text is not Cinnamon's to trust. It comes from window titles and
from tray icons over D-Bus, and CopyQ publishes the current clipboard
contents on the second line of its own tray tooltip. Copying a URL with an
'&' in it, or any code containing '<', therefore reaches Pango as invalid
markup, as do CopyQ's own placeholders for a clipboard that is empty, hidden
or an image. Clutter then logs

  Failed to set the markup of the actor 'ClutterText':
    Unknown tag 'EMPTY' on line 2 char 9

and discards the caller's formatting.

Validate the string and fall back to showing it literally, which is what
js/ui/messageTray.js's _fixMarkup already does for notification text.

--- a/js/ui/tooltips.js
+++ b/js/ui/tooltips.js
@@ -4,6 +4,7 @@
 const Gio = imports.gi.Gio;
 const Clutter = imports.gi.Clutter;
 const GLib = imports.gi.GLib;
+const Pango = imports.gi.Pango;
 
 const Applet = imports.ui.applet;
 const Main = imports.ui.main;
@@ -14,6 +15,23 @@
 const CURSOR_SIZE_KEY = 'cursor-size';
 
 /**
+ * _validMarkupOrEscaped:
+ * @markup (string): the string a caller wants rendered as markup
+ *
+ * Returns @markup when Pango can parse it, and an escaped copy when it
+ * cannot, so that text Cinnamon does not control renders literally instead
+ * of being discarded with a warning.
+ */
+function _validMarkupOrEscaped(markup) {
+    try {
+        Pango.parse_markup(markup, -1, '');
+        return markup;
+    } catch (e) {
+        return GLib.markup_escape_text(markup, -1);
+    }
+}
+
+/**
  * #TooltipBase
  * @item (Clutter.Actor): The object owning the tooltip.
  * @visible (boolean): Whether the tooltip is currently visible
@@ -280,7 +298,7 @@
      * Sets the text to display to @markup.
      */
     set_markup: function(markup) {
-        this._tooltip.set_text(markup);
+        this._tooltip.set_text(_validMarkupOrEscaped(markup));
         this._tooltip.clutter_text.set_use_markup(true);
         this._tooltip.clutter_text.allocate_preferred_size(Clutter.AllocationFlags.NONE);
